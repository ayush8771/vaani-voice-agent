# ── Required ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
FLASK_ENV=development

# ── Restaurant ───────────────────────────────────────────────────────────────
RESTAURANT_NAME=AM Restaurant
RESTAURANT_PHONE=+91-98765-43210
PRIVATE_DINING_EMAIL=events@amrestaurant.in
TIMEZONE=Asia/Kolkata

# Opening hours per day as JSON. A day left out = closed.
# Keep these in line with the hours in your knowledge PDF.
# Without OPENING_HOURS, START_HOUR to END_HOUR applies every day.
# OPENING_HOURS={"mon":[["12:00","15:30"],["19:00","23:00"]],"tue":[["12:00","15:30"],["19:00","23:00"]],"wed":[["12:00","15:30"],["19:00","23:00"]],"thu":[["12:00","15:30"],["19:00","23:00"]],"fri":[["12:00","15:30"],["19:00","23:30"]],"sat":[["12:00","16:00"],["19:00","23:30"]],"sun":[["12:00","16:00"],["19:00","23:00"]]}
START_HOUR=10
END_HOUR=22

# Seats per table, one number per table (labelled T1, T2, ...)
TABLE_SEATS=2,2,4,4,4,6,6,8,10
DINING_MINUTES=90
# Groups larger than this go to private dining
LARGE_GROUP_THRESHOLD=10

# ── Storage and limits ───────────────────────────────────────────────────────
DB_PATH=bookings.db
# memory:// for development; redis://localhost:6379 to share limits across workers
RATELIMIT_STORAGE_URI=memory://

# ── Voice and AI ─────────────────────────────────────────────────────────────
# One LLM for everything (agent, fallback slot reading, menu answers).
# Any OpenAI-compatible endpoint works: Ollama locally, or Sarvam later
# (LLM_BASE_URL=https://api.sarvam.ai/v1, LLM_MODEL=sarvam-30b, LLM_API_KEY=...).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TIMEOUT=45
AGENT_ENABLED=true
AGENT_MAX_STEPS=5
# Embeddings for the knowledge base still use Ollama directly
OLLAMA_URL=http://localhost:11434/api/generate
TTS_ENABLED=true
RAG_AUTOBUILD=true
RAG_MAX_DISTANCE=0.55
RAG_MIN_LEXICAL_OVERLAP=0.08

# ── Speech: Gnani Prisma (speech-to-text) and Timbre (text-to-speech) ───────
# One key for both, or separate GNANI_STT_KEY / GNANI_TTS_KEY.
# Without a key, Vaani uses the browser's speech recognition and Edge-TTS.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
# prisma-v3.0 with indic-auto detects the caller's language on every turn
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=indic-auto
GNANI_STT_FORMAT=verbatim
# Timbre v3.0 voices speak all 10 languages (e.g. Shivani, Avinash, Riyaa, Rahulmehta)
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_SPEED=1.0

# ── Verification codes (cancel by voice) ─────────────────────────────────────
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=3
# Demo only: speak the code when WhatsApp is not configured. Never in production.
OTP_DEV_ECHO=false

# ── Admin login ──────────────────────────────────────────────────────────────
# Accounts are created with: python manage.py create-admin --role owner
LOGIN_MAX_FAILS=5
LOGIN_LOCKOUT_SECONDS=300

# ── WhatsApp via Twilio (optional) ───────────────────────────────────────────
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
OWNER_WHATSAPP=
# Public HTTPS address of this app (e.g. your ngrok URL), used for QR image links
PUBLIC_BASE_URL=
